#!/sbin/openrc-run
description="Podroid VM networking (10.0.2.15 via SLIRP)"

depend() {
    need podroid-bootstrap
    before podroid-ready dropbear
    provide net
}

start() {
    ebegin "Configuring network..."
    echo "Configuring containers..." > /dev/console
    ip link set lo up 2>/dev/null
    NETIF=""
    for _i in $(seq 1 10); do
        # Exclude virtual/bridge devices so the real virtio NIC is picked.
        # The LXC bridge lxcbr0 (brought up by the dnsmasq.lxcbr0 service),
        # podman/docker/cni bridges, and veth pairs would otherwise be
        # candidates; the grep below filters them all out by name.
        NETIF=$(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | \
            grep -vE '^(lo|dummy[0-9]*|veth|podman|cni|docker|lxcbr|br-)' | head -1)
        [ -n "$NETIF" ] && break
        sleep 0.05
    done
    if [ -z "$NETIF" ]; then
        eend 1 "no network interface"
        return 1
    fi
    ip link set "$NETIF" up

    if grep -q 'podroid\.backend=avf' /proc/cmdline 2>/dev/null; then
        # AVF backend: crosvm wires the guest to a TAP that Android's tethering
        # manager runs DHCP on. The lease decides our IP / gateway / DNS — the
        # SLIRP-style 10.0.2.15 hardcode won't sit on the right subnet (on
        # IPv6-only cellular w/ CLAT it lands on 192.0.0.x). udhcpc applies
        # everything via the default /usr/share/udhcpc/default.script.
        udhcpc -i "$NETIF" -t 8 -T 1 -A 1 -q -f -n 2>/dev/null || \
            udhcpc -i "$NETIF" -q -f -n 2>/dev/null || true
        # Belt-and-suspenders: if DHCP didn't write resolv.conf (busybox
        # variants differ), drop public DNS so apk/curl don't die silently.
        [ -s /etc/resolv.conf ] || printf 'nameserver 8.8.8.8\nnameserver 1.1.1.1\n' > /etc/resolv.conf
        # Don't report success on a total DHCP failure: dependents that
        # `need` us would start believing the link is up, then SSH/apk fail
        # with no obvious cause. Surface it instead.
        if ! ip -o -4 addr show dev "$NETIF" 2>/dev/null | grep -q 'inet '; then
            eend 1 "DHCP did not assign an address to $NETIF"
            return 1
        fi
    else
        # QEMU/TCG backend: SLIRP runs its own DHCP server at 10.0.2.2 (leases
        # 10.0.2.15) and a guest-facing DNS at 10.0.2.3. Prefer udhcpc — it
        # configures the address and default route atomically. Fall back to the
        # historical static config only when the DHCP client is missing or the
        # server never answers (some host firewalls block the BOOTP exchange).
        if command -v udhcpc >/dev/null 2>&1; then
            udhcpc -i "$NETIF" -t 8 -T 1 -A 1 -q -f -n 2>/dev/null || true
        fi
        if ! ip -o -4 addr show dev "$NETIF" 2>/dev/null | grep -q 'inet '; then
            ip addr add 10.0.2.15/24 dev "$NETIF" 2>/dev/null
        fi
        # DHCP or static, make sure the SLIRP gateway route exists (idempotent).
        ip route add default via 10.0.2.2 dev "$NETIF" 2>/dev/null || true
        # DNS: prefer the ANDROID DEVICE's own resolvers. The app passes them in
        # via the `podroiddns=` kernel cmdline param (comma-separated IPv4). On
        # many carriers the hardcoded public resolvers below (8.8.8.8 / 1.1.1.1)
        # are blocked for outbound DNS, so a guest pointed at them first gets
        # "DNS: no address for host" and apk/curl/podman pulls all fail. The
        # device's real resolvers are reachable through SLIRP, so we write them
        # FIRST and keep the public ones + SLIRP's 10.0.2.3 as fallbacks.
        # Mirrors StrykerApp's bootroot, which writes the device net.dnsN into
        # the guest resolv.conf rather than hardcoding public DNS.
        : > /etc/resolv.conf
        for _d in $(cat /proc/cmdline 2>/dev/null | tr ' ' '\n' | grep '^podroiddns=' | cut -d= -f2 | tr ',' ' '); do
            case "$_d" in
                *.*.*.*) echo "nameserver $_d" >> /etc/resolv.conf ;;
            esac
        done
        if [ ! -s /etc/resolv.conf ]; then
            printf 'nameserver 8.8.8.8\nnameserver 1.1.1.1\n' >> /etc/resolv.conf
        fi
        printf 'nameserver 10.0.2.3\n' >> /etc/resolv.conf
        # Reachability probe: report which resolvers actually answer so the
        # app-side log + console expose a DNS failure instead of a silent
        # "internet broken". A 5s UDP/TCP probe to the first nameserver.
        _probe_ns=$(awk '/^nameserver/ {print $NF; exit}' /etc/resolv.conf 2>/dev/null)
        if [ -n "$_probe_ns" ] && command -v nc >/dev/null 2>&1; then
            if nc -z -u -w2 "$_probe_ns" 53 2>/dev/null || nc -z -w2 "$_probe_ns" 53 2>/dev/null; then
                echo "DNS: reachable via $_probe_ns" > /dev/console
            else
                echo "DNS: UNREACHABLE via $_probe_ns (check carrier DNS blocking)" > /dev/console
            fi
        fi
        # Mirror the AVF post-check: if the static assignment didn't stick
        # (wrong NIC, link not up), don't report success. Dependents that
        # `need` us would assume the link is up and then SSH/apk fail with no
        # obvious cause. Surface it instead.
        if ! ip -o -4 addr show dev "$NETIF" 2>/dev/null | grep -q 'inet '; then
            eend 1 "static IP did not stick on $NETIF"
            return 1
        fi
    fi
    # Report the assigned address on the console: it lands in console.log, so
    # the app's boot log (and the automated boot test's "IP:" check) shows the
    # VM's own address instead of a silent "no IP".
    VM_IP=$(ip -o -4 addr show dev "$NETIF" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
    echo "IP: ${VM_IP:-none}" > /dev/console
    echo "Network found" > /dev/console
    eend 0
}
